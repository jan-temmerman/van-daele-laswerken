{
  "name": "van-daele-laswerken",
  "compatibility_date": "2026-10-01",
  // Volledig statische site (nuxt generate): enkel assets, geen Worker-script
  "assets": {
    "directory": "./.output/public",
    "not_found_handling": "404-page",
    // privacy/index.html op /privacy serveren (zoals canonical en sitemap), niet via 307 naar /privacy/
    "html_handling": "drop-trailing-slash"
  }
}
